# Site address comes from .env.deploy:
#   unset            → plain HTTP on :80   (same-house try-outs only)
#   ARIA_TLS_DOMAIN=yourname.duckdns.org → Caddy serves HTTPS automatically
# (Let's Encrypt). deploy/README.md §HTTPS has the full walk-through.
{$ARIA_TLS_DOMAIN::80} {
	# The edge does NOT gate with a shared password — accounts-mode logins
	# (backend sessions) protect the API; the SPA must load unauthenticated
	# so students reach the login screen.

	# API → backend (same-origin, so the frontend needs no CORS changes)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Serve precompressed .gz/.br sidecars built by `npm run build`
	encode gzip zstd

	# Frontend static build (built by the frontend-build service)
	handle {
		root * /srv/frontend
		file_server
		try_files {path} /index.html
	}
}
