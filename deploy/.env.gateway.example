# ARIA gateway secrets — copy to .env.gateway (gitignored) and edit.
# This file is the ONLY place the upstream Anthropic key exists on the VM.
# The backend container never receives anything from this file: it only
# ever holds a minted gw_… token (see deploy/.env.deploy.example).

# The single upstream key (console.anthropic.com). /v1/messages refuses to
# serve until this is set. Treat it like the deed to the house.
ANTHROPIC_API_KEY=sk-ant-REPLACE

# Bearer token for /admin/* — mints gw_ tokens, reads spend, flips the
# kill switch. The admin API answers on the VM loopback only
# (127.0.0.1:8088), so this secret never crosses the internet.
# oracle-setup.sh generates a random value for you; change it if you like.
GATEWAY_ADMIN_TOKEN=REPLACE-me-or-run-the-setup-script

# Models students may request. Pilot default: the cheap, fast one.
# Sonnet-class answers cost roughly 20x Haiku's input price — add it only
# deliberately, and check platform.claude.com pricing before charging.
GATEWAY_MODEL_ALLOWLIST=claude-haiku-5-5

# Per-gw-token cost caps (USD). Requests past a cap get 429 — refused,
# never silently racked up.
GATEWAY_DEFAULT_DAILY_CAP_USD=0.50
GATEWAY_DEFAULT_MONTHLY_CAP_USD=10.00
