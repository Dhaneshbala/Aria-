# ARIA VM deployment config — copy to .env.deploy (gitignored) and edit.
# docker-compose.yml feeds this straight into the backend container, so these
# are process env vars exactly like a local .env (backend/config/settings.py).
#
# Secrets go in this file only — never commit .env.deploy.

# ── Auth: per-student accounts mode (docs/OPERATIONS.md §2) ──────────────
# accounts = every /api call needs a login session; legacy local mode never
# runs on a public server.
ARIA_AUTH_MODE=accounts
# 1 while the pilot group signs up. Set 0 to close registration.
ARIA_OPEN_REGISTRATION=1

# IMPORTANT: do NOT set ARIA_API_TOKEN on an accounts-mode server. The
# shared-bearer gate rejects per-student session tokens on non-loopback
# connections and would break remote logins. Sessions ARE the gate here.

# ── HTTPS (deploy/README.md §HTTPS) ────────────────────────────────────────
# Blank = plain HTTP on :80 (same-house try-outs only). Set to your free
# DuckDNS name to switch Caddy to automatic HTTPS (Let's Encrypt):
# ARIA_TLS_DOMAIN=yourname.duckdns.org

# ── Models (VM is CPU-only Ampere; gemma3:12b is the deploy default) ─────
ARIA_MAIN_MODEL=gemma3:12b
MODELS_MAIN=gemma3:12b
REASONING_MODEL=gemma3:12b
VISION_MODEL=gemma3:12b
FALLBACK_MODEL=gemma3:12b
CODING_MODEL=gemma3:12b
ARIA_EMBED_MODEL=nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ── Cloud (OPTIONAL — off for the VM pilot) ──────────────────────────────
# Student credit wallet already gates every cloud call: a student with an
# empty wallet is refused until an admin grants credit, so the VM pilot
# never spends anything unless you deliberately consent AND grant.
# ARIA_CLOUD_CONSENT=1
# ANTHROPIC_API_KEY=sk-ant-…        (or set these on the GATEWAY instead —
#                                    see docs/PAYMENTS_DESIGN.md; the app
#                                    itself must never hold provider keys)
