{
  "description": "Example organization rules for the ARIA File Organizer. Rules run before AI (highest priority first). Conditions match file fields; actions decide the outcome.",
  "fields": ["extension", "name", "title", "category", "subject", "topic", "doc_type", "folder", "size", "path", "tag", "project"],
  "operators": ["eq", "contains", "in", "regex", "gt", "lt"],
  "actions": ["move_to_folder", "set_folder", "rename_to"],
  "rules": [
    {
      "name": "Screenshots to General/Screenshots",
      "enabled": 1,
      "priority": 95,
      "conditions": [
        { "field": "name", "op": "regex", "value": "(screenshot|screen_shot|Screen Shot)" }
      ],
      "actions": [ { "action": "move_to_folder", "value": "General/Screenshots" } ],
      "scope": "all"
    },
    {
      "name": "Code files to Computing/Programming",
      "enabled": 1,
      "priority": 90,
      "conditions": [
        { "field": "category", "op": "in", "value": ["code"] }
      ],
      "actions": [ { "action": "move_to_folder", "value": "Computing/Programming" } ],
      "scope": "all"
    },
    {
      "name": "Past papers and exams",
      "enabled": 1,
      "priority": 85,
      "conditions": [
        { "field": "title", "op": "regex", "value": "(past paper|exam|test)" }
      ],
      "actions": [ { "action": "move_to_folder", "value": "General/Past Papers" } ],
      "scope": "all"
    },
    {
      "name": "Invoices and receipts to General/Finances",
      "enabled": 1,
      "priority": 80,
      "conditions": [
        { "field": "title", "op": "regex", "value": "(invoice|receipt|payment|bill)" }
      ],
      "actions": [ { "action": "move_to_folder", "value": "General/Finances" } ],
      "scope": "all"
    },
    {
      "name": "Maths homework to Mathematics/Number & Algebra",
      "enabled": 1,
      "priority": 75,
      "conditions": [
        { "field": "subject", "op": "eq", "value": "Mathematics" },
        { "field": "doc_type", "op": "eq", "value": "Homework" }
      ],
      "actions": [ { "action": "move_to_folder", "value": "Mathematics/Number & Algebra" } ],
      "scope": "all"
    },
    {
      "name": "Science notes to Science/Cells & Living Things",
      "enabled": 1,
      "priority": 70,
      "conditions": [
        { "field": "title", "op": "contains", "value": "cell" }
      ],
      "actions": [ { "action": "move_to_folder", "value": "Science/Cells & Living Things" } ],
      "scope": "all"
    },
    {
      "name": "Big media files to General/Media",
      "enabled": 1,
      "priority": 40,
      "conditions": [
        { "field": "extension", "op": "in", "value": [".mp4", ".mov", ".mkv"] },
        { "field": "size", "op": "gt", "value": 104857600 }
      ],
      "actions": [ { "action": "move_to_folder", "value": "General/Media" } ],
      "scope": "all"
    },
    {
      "name": "Rename image exports",
      "enabled": 1,
      "priority": 20,
      "conditions": [
        { "field": "name", "op": "contains", "value": "image" }
      ],
      "actions": [ { "action": "rename_to", "value": "image_export" } ],
      "scope": "all"
    }
  ]
}
