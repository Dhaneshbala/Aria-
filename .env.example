# ARIA — copy to .env and edit
# Ollama — where the local AI runs (default 127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Models — single main + embedding (M4 16GB tuned)
ARIA_MAIN_MODEL=gemma3:12b
ARIA_EMBED_MODEL=nomic-embed-text

# Data — where chats, memory, KB are stored
ARIA_DATA_DIR=/Users/YOU/.aria_data

# Optional: CORS (default localhost:5173,4173,3000)
# ARIA_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: expose backend on LAN for phone access (default 127.0.0.1 = this Mac only)
# ARIA_HOST=0.0.0.0
# ARIA_PORT=8000
# ARIA_CORS_ORIGINS=http://localhost:5173,http://192.168.1.10:5173
# Frontend LAN build: cd frontend && VITE_API_URL=http://192.168.1.10:8000/api npm run build

# Optional: quiz verification (1=verified ~8-12s, 0=instant 5-8s)
# ARIA_QUIZ_VERIFY=1

# ── Cloud AI providers (OFF by default — see docs/PROVIDERS.md) ──────────────
# ARIA is fully local + private. Enabling Anthropic sends student messages
# to api.anthropic.com and costs per token. Both lines are required:
# ANTHROPIC_API_KEY=sk-ant-…           (your key from console.anthropic.com)
# ARIA_CLOUD_CONSENT=1                 (explicit consent for cloud inference)
# Optional pricing overrides (USD per million tokens — cost estimates only):
# ANTHROPIC_PRICE_INPUT_MTOK=0.10
# ANTHROPIC_PRICE_OUTPUT_MTOK=0.50

# ── Research / web search ─────────────────────────────────────────────────────
# Default: verify TLS, but after an SSL error (school proxy) retry once
# without verification (logged). Set to 1 to never downgrade:
# ARIA_SEARCH_STRICT_TLS=1

# Optional: backend data paths already respect ARIA_DATA_DIR (idle learner included)

# Web search HTTPS: strictly verify TLS certificates (recommended).
# Set to 0 ONLY on school/corporate networks whose proxies break TLS chains —
# web results feed the tutor prompt, so unverified TLS could inject content.
# ARIA_SEARCH_STRICT_TLS=0

# Optional server password for shared-hosting use (localhost alone stays open)
# ARIA_API_TOKEN=choose-a-long-password
# Optional separate password for the agent terminal/file endpoints
# ARIA_AGENT_TOKEN=choose-another-long-password
