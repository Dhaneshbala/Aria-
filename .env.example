# ARIA — Environment Variables
# Copy to .env and customise. All have sensible defaults for MacBook Air M4 16GB.

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Model routing (override auto-detection) ──────────────────────────────────
ARIA_MAIN_MODEL=gemma4:e4b-mlx
ARIA_EMBED_MODEL=nomic-embed-text

# ── Backend server ───────────────────────────────────────────────────────────
ARIA_BACKEND_HOST=127.0.0.1
ARIA_BACKEND_PORT=8000
ARIA_FRONTEND_PORT=5173

# ── CORS (comma-separated origins) ──────────────────────────────────────────
ARIA_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:4173

# ── Rate limiting ────────────────────────────────────────────────────────────
ARIA_RATE_LIMIT_GLOBAL=120/minute
ARIA_RATE_LIMIT_CHAT=30/minute

# ── Upload limits (bytes) ────────────────────────────────────────────────────
ARIA_MAX_IMAGE_BYTES=20971520
ARIA_MAX_DOC_BYTES=52428800
ARIA_MAX_MESSAGE_CHARS=8000
ARIA_MAX_UPLOAD_FILES=10

# ── Chat / LLM ──────────────────────────────────────────────────────────────
ARIA_DEFAULT_CONTEXT_CHARS=8000
ARIA_MAX_CONTEXT_CHARS=15000
ARIA_OLLAMA_TIMEOUT_SECS=120.0
ARIA_EMBED_TIMEOUT_SECS=65.0
ARIA_LLM_MAX_TOKENS=2048

# ── Backup ───────────────────────────────────────────────────────────────────
ARIA_MAX_BACKUPS=10
ARIA_MAX_RESTORE_BYTES=524288000

# ── Logging ──────────────────────────────────────────────────────────────────
ARIA_LOG_MAX_BYTES=2097152
ARIA_LOG_BACKUP_COUNT=5

# ── Database ─────────────────────────────────────────────────────────────────
ARIA_DB_WAL_CHECKPOINT_INTERVAL=1000

# ── Data directory ───────────────────────────────────────────────────────────
ARIA_DATA_DIR=~/.aria_data

# ── Student ──────────────────────────────────────────────────────────────────
ARIA_STUDENT_AGE=13
