# ARIA — copy to .env and edit
# Ollama — where the local AI runs (default 127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Models — single main + embedding (M4 16GB tuned)
ARIA_MAIN_MODEL=gemma4:e4b-mlx
ARIA_EMBED_MODEL=nomic-embed-text

# Data — where chats, memory, KB are stored
ARIA_DATA_DIR=/Users/YOU/.aria_data

# Optional: organizer DB override (default backend/storage/organizer.db)
# ARIA_ORGANIZER_DB=/Users/YOU/.aria_data/organizer.db

# Optional: CORS (default localhost:5173,4173,3000)
# ARIA_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: quiz verification (1=verified ~8-12s, 0=instant 5-8s)
# ARIA_QUIZ_VERIFY=1
